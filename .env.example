DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jluxe?schema=public"
RESEND_API_KEY=
ENQUIRY_NOTIFICATION_EMAIL=website@thejluxex.com
RESEND_FROM_EMAIL="JLUXE Enquiries <onboarding@resend.dev>"
ADMIN_SESSION_SECRET=

# Cloudflare Turnstile (public site key in the browser, secret key on the server).
# For local-only testing, use Cloudflare's published test key pair; use real keys in Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

#media

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=jluxe-media
# Careers resumes use the server-side Cloudinary API credentials above for
# authenticated raw uploads. They do not use CLOUDINARY_UPLOAD_PRESET.
