generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  OWNER
  ADMIN
  EDITOR
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PropertyType {
  PLOT
  VILLA
  APARTMENT
  COMMERCIAL
  LAND
  OTHER
}

enum PropertyStatus {
  AVAILABLE
  UNDER_OFFER
  SOLD
  LEASED
  WITHDRAWN
}

enum RepresentationType {
  CHANNEL_PARTNER
  AUTHORIZED_REPRESENTATIVE
  OTHER
}

enum PriceMode {
  EXACT
  STARTING_FROM
  ON_REQUEST
}

enum PlotSizeUnit {
  SQFT
  SQM
  ACRE
  HECTARE
}

enum EnquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model Admin {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(320)
  displayName  String   @db.VarChar(150)
  role         AdminRole
  isActive     Boolean  @default(true)
  passwordHash String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  uploadedMedia Media[]
}

model Service {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String            @unique @db.VarChar(120)
  title             String            @db.VarChar(150)
  description       String?
  publicationStatus PublicationStatus @default(DRAFT)
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)

  enquiries      Enquiry[]
  portfolioWorks PortfolioWork[]

  @@index([publicationStatus, sortOrder])
}

model Property {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String             @unique @db.VarChar(180)
  title              String             @db.VarChar(200)
  description        String?
  location           String?            @db.VarChar(255)
  propertyType       PropertyType
  priceAmount        Decimal?           @db.Decimal(14, 2)
  priceCurrency      String?            @db.Char(3)
  priceMode          PriceMode           @default(EXACT)
  plotSize           Decimal?           @db.Decimal(12, 2)
  plotSizeUnit       PlotSizeUnit?
  status             PropertyStatus
  representationType RepresentationType
  publicationStatus  PublicationStatus  @default(DRAFT)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)

  enquiries Enquiry[]
  media     PropertyMedia[]

  @@index([publicationStatus, status, propertyType])
  @@index([priceAmount])
  @@index([plotSize])
}

model PortfolioWork {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String            @unique @db.VarChar(180)
  title             String            @db.VarChar(200)
  serviceId         String            @db.Uuid
  description       String
  location          String?           @db.VarChar(255)
  year              Int?              @db.SmallInt
  featured          Boolean           @default(false)
  publicationStatus PublicationStatus @default(DRAFT)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)

  service Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  media   PortfolioWorkMedia[]

  @@index([serviceId])
  @@index([publicationStatus, featured])
}

model Enquiry {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String        @db.VarChar(150)
  email                  String        @db.VarChar(320)
  phone                  String        @db.VarChar(32)
  interestedServiceId    String?       @db.Uuid
  interestedServiceLabel String        @db.VarChar(150)
  message                String
  propertyId             String?       @db.Uuid
  status                 EnquiryStatus @default(NEW)
  createdAt              DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(6)

  interestedService Service?  @relation(fields: [interestedServiceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  property          Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([interestedServiceId])
  @@index([propertyId])
  @@index([status, createdAt])
}

model Media {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey       String   @unique @db.VarChar(500)
  provider         String   @db.VarChar(50)
  mimeType         String   @db.VarChar(100)
  byteSize         BigInt
  width            Int?
  height           Int?
  uploadedByAdminId String? @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  uploadedByAdmin Admin?              @relation(fields: [uploadedByAdminId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  properties      PropertyMedia[]
  portfolioWorks  PortfolioWorkMedia[]

  @@index([uploadedByAdminId])
}

model PropertyMedia {
  propertyId String  @db.Uuid
  mediaId    String  @db.Uuid
  position   Int
  altText    String? @db.VarChar(255)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  media    Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([propertyId, mediaId])
  @@unique([propertyId, position])
  @@index([mediaId])
}

model PortfolioWorkMedia {
  portfolioWorkId String  @db.Uuid
  mediaId         String  @db.Uuid
  position        Int
  altText         String? @db.VarChar(255)

  portfolioWork PortfolioWork @relation(fields: [portfolioWorkId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  media         Media         @relation(fields: [mediaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([portfolioWorkId, mediaId])
  @@unique([portfolioWorkId, position])
  @@index([mediaId])
}